        "requiredGesture": "THUMB_UP",
        "gestureHint": "竖起大拇指确认进入！",
        "animationTrigger": "fade_in"
      },
      {
        "pageId": 2,
        "content": "哎呀！前面有一块大石头挡住了路。我们需要把它推开！",
        "image": "big_rock.jpg",
        "requiredGesture": "OPEN_PALM",
        "gestureHint": "张开手掌向前推！",
        "animationTrigger": "shake"
      },
      {
        "pageId": 3,
        "content": "哇！一只友好的小精灵飞过来了。和它打个招呼吧！",
        "image": "fairy.jpg",
        "requiredGesture": "WAVE",
        "gestureHint": "挥挥手和精灵打招呼！",
        "animationTrigger": "sparkle"
      },
      {
        "pageId": 4,
        "content": "小精灵送给你一颗爱心宝石。收下它吧！",
        "image": "gem.jpg",
        "requiredGesture": "HEART",
        "gestureHint": "双手比心接收礼物！",
        "animationTrigger": "zoom_in"
      }
    ]
  },
